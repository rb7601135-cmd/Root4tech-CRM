# ==============================================================================
# Roo4Tech Smart CRM — Backend Production Environment Configuration
# ==============================================================================

# Core Security
SECRET_KEY=change-this-to-a-high-entropy-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=crm.roo4tech.com,api.roo4tech.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://crm.roo4tech.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://crm.roo4tech.com,http://localhost:3000
SECURE_SSL_REDIRECT=True

# Database (PostgreSQL recommended for production)
# Format: postgres://username:password@hostname:5432/database_name
# Leave empty to default to local SQLite database (for dev/test only)
DATABASE_URL=postgres://roo4tech_admin:SecureDatabasePassword123!@localhost:5432/roo4tech_crm

# AI Assistant Integration
# Supported providers: openai, gemini, anthropic, mock
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Company Defaults & Financials
DEFAULT_CURRENCY=PKR
COMPANY_NAME=Roo4Tech

# Email Delivery (SMTP for production, Console for local dev)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@roo4tech.com
EMAIL_HOST_PASSWORD=your-app-specific-email-password
DEFAULT_FROM_EMAIL=contact@roo4tech.com
