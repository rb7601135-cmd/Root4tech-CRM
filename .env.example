# Root4Tech CRM - Environment Configuration Example (Phase 3 Production & Development)
# Copy this file to .env and customize values according to your environment.

# -----------------------------------------------------------------------------
# 1. Django Core & Security
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-generate-a-strong-random-64-char-key-for-prod
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=crm.root4tech.com,www.root4tech.com,127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 2. Database Configuration
# -----------------------------------------------------------------------------
# Leave POSTGRES_DB unset to fall back to SQLite (db.sqlite3) for local development.
# For production PostgreSQL deployments, uncomment and configure:
# POSTGRES_DB=root4tech_crm_prod
# POSTGRES_USER=root4tech_admin
# POSTGRES_PASSWORD=your_production_secure_db_password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 3. HTTPS & Secure Cookie Settings (Ignored when DJANGO_DEBUG=True)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# -----------------------------------------------------------------------------
# 4. Outbound Email & Follow-Up Notification Service (SMTP)
# -----------------------------------------------------------------------------
# Uncomment for live email dispatch (SendGrid, Mailgun, AWS SES, or Google Workspace)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your_verified_sendgrid_production_key
# DEFAULT_FROM_EMAIL=Root4Tech CRM <notifications@root4tech.com>

# -----------------------------------------------------------------------------
# 5. External Services & Payment Gateway Note
# -----------------------------------------------------------------------------
# CRM records financial invoices and payment receipts internally.
# If connecting an online payment gateway (e.g. Stripe, PayPal, Razorpay) in future:
# STRIPE_PUBLIC_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
