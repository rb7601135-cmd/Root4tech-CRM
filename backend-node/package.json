{
  "name": "root4tech-crm-backend-node",
  "version": "1.0.0",
  "description": "Node.js + Express + Prisma backend for Root4Tech CRM (Vercel-ready)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
